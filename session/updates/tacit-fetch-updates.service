[Unit]
Description=Tacit: download the waiting updates (never installs them)
Wants=network-online.target
After=network-online.target
# not on the USB stick: its updates would go to memory and be gone at the next start
ConditionPathExists=!/run/archiso

[Service]
Type=oneshot
ExecStart=/usr/lib/tacit/tacit-fetch-updates
Nice=19
IOSchedulingClass=idle
CPUWeight=20
