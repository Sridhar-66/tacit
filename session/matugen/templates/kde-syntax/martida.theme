{
    "metadata": {
        "name": "Martida",
        "revision": 1,
        "license": "SPDX-License-Identifier: MIT"
    },
    "text-styles": {
        "Normal":         { "text-color": "{{colors.on_surface.default.hex}}",          "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Keyword":        { "text-color": "{{colors.primary.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "ControlFlow":    { "text-color": "{{colors.primary.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Preprocessor":   { "text-color": "{{colors.primary.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Attribute":      { "text-color": "{{colors.primary.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Function":       { "text-color": "{{colors.primary_fixed_dim.default.hex}}",   "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "BuiltIn":        { "text-color": "{{colors.primary_fixed_dim.default.hex}}",   "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "DataType":       { "text-color": "{{colors.tertiary_fixed_dim.default.hex}}",  "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Extension":      { "text-color": "{{colors.tertiary_fixed_dim.default.hex}}",  "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Variable":       { "text-color": "{{colors.on_surface.default.hex}}",          "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Import":         { "text-color": "{{colors.on_surface.default.hex}}",          "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Operator":       { "text-color": "{{colors.on_surface_variant.default.hex}}",  "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Others":         { "text-color": "{{colors.on_surface_variant.default.hex}}",  "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "String":         { "text-color": "{{colors.tertiary.default.hex}}",            "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "VerbatimString": { "text-color": "{{colors.tertiary.default.hex}}",            "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "SpecialString":  { "text-color": "{{colors.tertiary.default.hex}}",            "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Char":           { "text-color": "{{colors.tertiary.default.hex}}",            "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "SpecialChar":    { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "DecVal":         { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "BaseN":          { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Float":          { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Constant":       { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Comment":        { "text-color": "{{colors.outline.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}", "italic": true },
        "Documentation":  { "text-color": "{{colors.outline.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}", "italic": true },
        "Annotation":     { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}", "italic": true },
        "CommentVar":     { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}", "italic": true },
        "RegionMarker":   { "text-color": "{{colors.outline.default.hex}}",             "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Information":    { "text-color": "{{colors.secondary.default.hex}}",           "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Warning":        { "text-color": "{{colors.tertiary.default.hex}}",            "selected-text-color": "{{colors.on_secondary_container.default.hex}}" },
        "Alert":          { "text-color": "{{colors.error.default.hex}}",               "selected-text-color": "{{colors.on_secondary_container.default.hex}}", "bold": true },
        "Error":          { "text-color": "{{colors.error.default.hex}}",               "selected-text-color": "{{colors.on_secondary_container.default.hex}}", "underline": true }
    },
    "editor-colors": {
        "BackgroundColor":            "{{colors.surface.default.hex}}",
        "CurrentLine":                "{{colors.surface_container_low.default.hex}}",
        "LineNumbers":                "{{colors.outline_variant.default.hex}}",
        "CurrentLineNumber":          "{{colors.primary.default.hex}}",
        "IconBorder":                 "{{colors.surface.default.hex}}",
        "Separator":                  "{{colors.outline_variant.default.hex}}",
        "IndentationLine":            "{{colors.outline_variant.default.hex}}",
        "TabMarker":                  "{{colors.outline_variant.default.hex}}",
        "WordWrapMarker":             "{{colors.outline_variant.default.hex}}",
        "TextSelection":              "{{colors.primary_container.default.hex}}",
        "SearchHighlight":            "{{colors.primary_container.default.hex}}",
        "ReplaceHighlight":           "{{colors.tertiary_container.default.hex}}",
        "BracketMatching":            "{{colors.primary_container.default.hex}}",
        "CodeFolding":                "{{colors.surface_container.default.hex}}",
        "ModifiedLines":              "{{colors.tertiary.default.hex}}",
        "SavedLines":                 "{{colors.primary.default.hex}}",
        "SpellChecking":              "{{colors.error.default.hex}}",
        "MarkBookmark":               "{{colors.primary.default.hex}}",
        "MarkBreakpointActive":       "{{colors.error.default.hex}}",
        "MarkBreakpointDisabled":     "{{colors.outline.default.hex}}",
        "MarkBreakpointReached":      "{{colors.tertiary.default.hex}}",
        "MarkError":                  "{{colors.error.default.hex}}",
        "MarkExecution":              "{{colors.secondary.default.hex}}",
        "MarkWarning":                "{{colors.tertiary.default.hex}}",
        "TemplateBackground":         "{{colors.surface_container.default.hex}}",
        "TemplateFocusedPlaceholder": "{{colors.primary_container.default.hex}}",
        "TemplatePlaceholder":        "{{colors.surface_container_high.default.hex}}",
        "TemplateReadOnlyPlaceholder":"{{colors.surface_container_low.default.hex}}"
    }
}
