[Unit]
Description=Bluetooth pairing agent for the Tacit shell
# BlueZ is the whole point of the program: with no bluetoothd there is nothing to register with.
After=tacit-session.target
PartOf=tacit-session.target
# no Bluetooth in the computer, nothing to do: it restarted every 5 s for ever (the VM install test, 2026-10-16)
ConditionPathIsDirectory=/sys/class/bluetooth
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/lib/tacit/bin/quiet-btagent
# A crash while nothing is pairing costs nothing; a crash loop should not be silent, so the
# restart is slow enough to read in the journal.
Restart=on-failure
RestartSec=5
MemoryHigh=32M

[Install]
WantedBy=tacit-session.target
