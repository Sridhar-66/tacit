[Unit]
Description=Tacit: download the waiting updates (never installs them)
# no network-online.target (see tacit-fetch-updates-now.service): the timer's first look is 20 minutes after the start
# not on the USB stick: its updates would go to memory and be gone at the next start
ConditionPathExists=!/run/archiso

[Service]
Type=oneshot
ExecStart=/usr/lib/tacit/tacit-fetch-updates
Nice=19
IOSchedulingClass=idle
CPUWeight=20
# stopped by a restart or a shutdown halfway: pacman lets go of its lock on SIGINT, not on SIGTERM, and the lock it left
# made the install at the next start refuse to run and every later download skip (Discord, 2026-10-20)
KillSignal=SIGINT
