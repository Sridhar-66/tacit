# Graphis the app (code-open opens a project). Files open through graphis-file.desktop: with file types here this
# entry won where no default names one (an empty file, XML) and code-open dropped the file.
[Desktop Entry]
Name=Graphis
GenericName=Code Editor
Comment=Read and edit code
Keywords=code;editor;edit;text;ide;developer;graphis;
Exec=code-open
Icon=accessories-text-editor
Terminal=false
Type=Application
Categories=Development;TextEditor;
StartupWMClass=graphis
Actions=
