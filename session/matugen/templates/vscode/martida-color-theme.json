  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "{{colors.secondary.default.hex}}" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "{{colors.primary_fixed_dim.default.hex}}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "{{colors.tertiary_fixed_dim.default.hex}}" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "{{colors.on_surface.default.hex}}" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "{{colors.secondary_fixed_dim.default.hex}}" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}", "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{colors.error.default.hex}}" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" }
    }
  ]
}
