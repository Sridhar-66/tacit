[Desktop Entry]
Name=Viewer
GenericName=Picture, PDF and media viewer
Comment=Look at pictures, PDFs, video and audio
Keywords=image;picture;photo;pdf;video;audio;music;viewer;
Exec=viewer-open %f
Icon=image-x-generic
Terminal=false
Type=Application
Categories=Graphics;Viewer;AudioVideo;
StartupWMClass=viewer
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;image/x-icon;application/pdf;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-m4v;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/x-wav;audio/wav;audio/mp4;audio/x-m4a;audio/aac;
