#!/bin/sh
# Open one file in the code editor (code.qml): its git project first, then the file, at LINE
# when given, or at the first line containing FIND. Used by the Claude app's edit rows and
# changes panel.   code-file <path> [line] [find]
#
# The probe, the single-launch lock, the poll and the failure notice are tacit-app's, shared with
# code-open and claude-hand.
T_BIN=${TACIT_BIN:-$HOME/.local/bin}                          # Tacit's launchers (the package sets TACIT_BIN)
f=$(realpath "$1") || exit 1
line=${2:-0}
if [ -n "${3:-}" ]; then
	n=$(grep -nF -m1 -- "$3" "$f" 2>/dev/null | cut -d: -f1)
	[ -n "$n" ] && line=$n
fi
dir=$(dirname "$f")
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || top=$dir
T="$T_BIN/tacit-app"
state=$(CODE_PROJECT="$top" "$T" ensure graphis) || exit 1
if [ "$state" = up ]; then
	cur=$("$T" call graphis root 2>/dev/null)
	if [ "$cur" != "$top" ]; then
		# Graphis keeps its project while it has unsaved changes; the file, asked for by its path in the project it was
		# meant for, then opened the other project's file of the same name (and a save wrote there)
		case $("$T" call graphis open "$top") in
		*'"opened":false'*)
			"$T" call graphis present
			"$T" focus graphis
			notify-send -a Graphis "Save your changes first" "Graphis has unsaved changes in $(basename "$cur"). Save them, then open $(basename "$f") again."
			exit 0 ;;
		esac
	fi
fi
"$T" call graphis present      # a closed window only hides
"$T" call graphis fileAt "${f#"$top"/}" "$line"
"$T" focus graphis
exit 0
