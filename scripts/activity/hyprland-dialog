#!/bin/bash
# hyprland-dialog, Tacit's: installed to ~/.local/bin, which comes before /usr/bin on Hyprland's PATH.
#
# Hyprland finds an app that stopped answering (it missed its pings) and runs hyprland-dialog with
# "Application Not Responding" and the buttons Terminate;Wait. That one dialog becomes the notch's
# prompt instead (IslandController.notAnswering): the answer comes back on a fifo as the button's own
# text, printed here for Hyprland to act on (Terminate = it kills the app). When the app answers again,
# Hyprland ends this process and the prompt goes with it. Every other dialog, and this one when the
# shell is not there to show it, goes to the real hyprland-dialog unchanged.
real=/usr/bin/hyprland-dialog
# the shell by its folder, as it was started: `qs -c tacit` names /etc/xdg/quickshell/tacit, which an installed system's
# shell (started with -p /usr/share/tacit/shell) does not answer to, so every dialog fell back to the plain one
shell=${TACIT_SHELL:-$HOME/.config/quickshell/tacit}
title="" text="" buttons=""
args=("$@")
while [ $# -gt 0 ]; do
	case "$1" in
	--title | --apptitle) title=$2; shift ;;
	--text) text=$2; shift ;;
	--buttons) buttons=$2; shift ;;
	esac
	shift
done
# Hyprland passes the title as --title (0.56; this looked for --apptitle and never took a dialog over). Only the
# not-answering dialog comes with a window rule to start on the app's workspace, in every language.
[ "$title" = "Application Not Responding" ] || [ -n "${HL_EXEC_RULE_TOKEN:-}" ] || exec "$real" "${args[@]}"

# The text names the window's title and class ("An application <title> - <class> is not responding." in English):
# the window, and so its process, is the one whose class and title are both in it.
read -r pid cls wtitle < <(hyprctl clients -j 2>/dev/null | python3 -I -c '
import json, sys
text = sys.argv[1]
cs = [c for c in json.load(sys.stdin) if c["class"] and c["class"] in text]
m = sorted([c for c in cs if c["title"] and c["title"] in text], key=lambda c: -len(c["title"])) or cs
print(m[0]["pid"], m[0]["class"], m[0]["title"]) if m else print(0, "", "")' "$text" 2>/dev/null)

IFS=';' read -r b1 b2 _ <<<"$buttons"
fifo="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tacit-anr-$$"
rm -f "$fifo" "$fifo.answer"
mkfifo -m 600 "$fifo" || exec "$real" "${args[@]}"
# the reader waits in the background: a trap runs during `wait`, not during a blocked foreground read
head -n1 "$fifo" >"$fifo.answer" &
reader=$!
gone() {
	kill "$reader" 2>/dev/null
	qs -p "$shell" ipc call island notAnsweringGone "$$" >/dev/null 2>&1
	rm -f "$fifo" "$fifo.answer"
	exit 0
}
trap gone TERM INT HUP
req=$(python3 -I -c 'import json, sys; print(json.dumps({"id": sys.argv[1], "cls": sys.argv[2], "title": sys.argv[3], "pid": int(sys.argv[4] or 0), "fifo": sys.argv[5], "buttons": [sys.argv[6], sys.argv[7]]}))' \
	"$$" "$cls" "$wtitle" "${pid:-0}" "$fifo" "${b1:-Terminate}" "${b2:-Wait}")
if [ "$(qs -p "$shell" ipc call island notAnswering "$req" 2>/dev/null)" != "shown" ]; then
	kill "$reader" 2>/dev/null
	rm -f "$fifo" "$fifo.answer"
	exec "$real" "${args[@]}"
fi
wait "$reader"
cat "$fifo.answer"
rm -f "$fifo" "$fifo.answer"
