#!/usr/bin/env python3
"""tacit-login-ground: the person's lock ground and colours for Tacit's login screen. Run as root by SDDM before the
greeter starts (sddm.service.d/tacit-login.conf): the greeter runs as the sddm user, who cannot read home folders.

Takes the newest lock ground among the people on this computer (with one person, theirs; tacit-boot-ground writes it
on every wallpaper change) and their colours, into /var/lib/tacit-login: ground.png and theme.conf, which the theme's
theme.conf.user links to. Only a plain file the person owns is read, never a link, a pipe or someone else's file.
Nothing found: the theme's own fallbacks (Tacit's palette, no picture).
"""
import json, os, pwd, shutil, stat, tempfile

OUT = "/var/lib/tacit-login"
KEYS = {"surface": "surface", "surfaceContainerHigh": "surface_container_high", "onSurface": "on_surface",
        "onSurfaceVariant": "on_surface_variant", "primary": "primary", "error": "error"}

def owned(path, uid):
    """an open file object for a plain file `uid` owns, else None"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 64 << 20:
        os.close(fd)
        return None
    return os.fdopen(fd, "rb")

def main():
    best = None
    for p in pwd.getpwall():
        if not 1000 <= p.pw_uid < 60000 or not p.pw_dir.startswith("/"):
            continue
        g = os.path.join(p.pw_dir, ".local/state/tacit-boot/lock-ground.png")
        try:
            st = os.lstat(g)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode) and st.st_uid == p.pw_uid and (best is None or st.st_mtime > best[0]):
            best = (st.st_mtime, p)
    os.makedirs(OUT, mode=0o755, exist_ok=True)
    if best is None:
        for f in ("ground.png", "theme.conf"):
            try: os.remove(os.path.join(OUT, f))
            except OSError: pass
        return
    p = best[1]
    lines = ["[General]"]
    src = owned(os.path.join(p.pw_dir, ".local/state/tacit-boot/lock-ground.png"), p.pw_uid)
    if src:
        with src, tempfile.NamedTemporaryFile(dir=OUT, delete=False) as tmp:
            shutil.copyfileobj(src, tmp)
        os.chmod(tmp.name, 0o644)
        os.replace(tmp.name, os.path.join(OUT, "ground.png"))
        lines.append(f"ground={OUT}/ground.png")
    src = owned(os.path.join(p.pw_dir, ".local/state/quickshell/user/generated/colors.json"), p.pw_uid)
    if src:
        try:
            with src:
                colors = json.load(src)
            for k, j in KEYS.items():
                v = str(colors.get(j, ""))
                if len(v) == 7 and v.startswith("#") and all(c in "0123456789abcdefABCDEF" for c in v[1:]):
                    lines.append(f"{k}={v}")
        except (ValueError, OSError):
            pass
    with tempfile.NamedTemporaryFile("w", dir=OUT, delete=False) as tmp:
        tmp.write("\n".join(lines) + "\n")
    os.chmod(tmp.name, 0o644)
    os.replace(tmp.name, os.path.join(OUT, "theme.conf"))

if __name__ == "__main__":
    main()
